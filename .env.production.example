# ==============================================================================
# Khashala (خُشاله) - Production Environment Configuration Template
# For VPS, Coolify, or Docker deployments
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=3000

# Base Application URL (Replace with your actual production domain)
NEXT_PUBLIC_APP_URL=https://khashala.com

# PostgreSQL Connection String
# If using Coolify PostgreSQL resource or docker-compose:
DATABASE_URL="postgresql://khashala_user:YOUR_STRONG_PASSWORD@db:5432/khashala_db?schema=public"

# Secure Random JWT Secret (Generate with: openssl rand -base64 32)
JWT_SECRET="PLEASE_GENERATE_A_LONG_SECURE_RANDOM_SECRET_KEY_FOR_PRODUCTION_2026"

# Optional: Custom Support & Admin defaults (can also be changed from /admin/settings)
SUPPORT_EMAIL=support@khashala.com
SUPPORT_PHONE=+966500000001
